-- Spelling variants with N = K: substr(), FROM 0 FOR 8, reversed operands
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_txn
WHERE substr(decode(txn -> 'txn' ->> 'note', 'base64'), 1, 7) = '\x5350414d535041'::bytea
ORDER BY round, intra LIMIT 10;
                                                              QUERY PLAN                                                              
--------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_note7_idx on pfx_txn
         Index Cond: ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) = '\x5350414d535041'::bytea)
(3 rows)

