-- N < K, len(B) < N: the note must equal B exactly
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_txn
WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 5) = '\x616263'::bytea
ORDER BY round, intra LIMIT 10;
                                                          QUERY PLAN                                                          
------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_note7_idx on pfx_txn
         Index Cond: ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) = '\x616263'::bytea)
(3 rows)

SELECT * FROM pfx_chk($$SELECT round, intra FROM pfx_txn WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 5) = '\x616263'::bytea$$);
 same |  n  
------+-----
 t    | 200
(1 row)

SELECT * FROM pfx_chk($$SELECT round, intra FROM pfx_txn WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\x6162'::bytea$$);
 same | n 
------+---
 t    | 0
(1 row)

-- N < K, len(B) > N: always false; lossy equality + original kept
SELECT * FROM pfx_chk($$SELECT round, intra FROM pfx_txn WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\x61626364'::bytea$$);
 same | n 
------+---
 t    | 0
(1 row)

-- N > K: equality on the first K bytes, original clause kept as filter
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_txn
WHERE round >= 100 AND typeenum = 1
  AND substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 12) = '\x5350414d5350414d2d303030'::bytea
ORDER BY round, intra LIMIT 10;
                                                                                  QUERY PLAN                                                                                  
------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_note7_idx on pfx_txn
         Index Cond: (("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) = '\x5350414d535041'::bytea) AND (round >= 100) AND (typeenum = 1))
         Filter: (SUBSTRING(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text) FROM 1 FOR 12) = '\x5350414d5350414d2d303030'::bytea)
(4 rows)

SELECT * FROM pfx_chk($$SELECT round, intra FROM pfx_txn WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 12) = '\x5350414d5350414d2d303030'::bytea$$);
 same |  n  
------+-----
