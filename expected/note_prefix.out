-- Byte-prefix index support (note_prefix.c planner hook).
-- The hook only needs the library loaded; it creates no SQL objects.
LOAD 'pg_algorand';
SET max_parallel_workers_per_gather = 0;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
CREATE TABLE pfx_txn (
    round    bigint   NOT NULL,
    intra    integer  NOT NULL,
    typeenum smallint NOT NULL,
    txn      jsonb    NOT NULL,
    PRIMARY KEY (round, intra)
);
INSERT INTO pfx_txn
SELECT r, i,
       CASE WHEN (r + i) % 10 < 2 THEN 1 ELSE 1 + (r + i) % 3 END,
       jsonb_build_object('txn', CASE (r + i) % 10
           WHEN 0 THEN jsonb_build_object('note', encode(convert_to('SPAMSPAM-' || lpad(r::text, 6, '0'), 'UTF8'), 'base64'))
           WHEN 1 THEN jsonb_build_object('note', encode(convert_to('SPAMSPAM-' || lpad(r::text, 6, '0'), 'UTF8'), 'base64'))
           WHEN 2 THEN jsonb_build_object('note', encode(convert_to('algo:' || to_hex(r * 7919 + i), 'UTF8'), 'base64'))
           WHEN 3 THEN jsonb_build_object('note', encode(convert_to('algo:' || to_hex(r * 7919 + i), 'UTF8'), 'base64'))
           WHEN 4 THEN jsonb_build_object('note', encode(convert_to('abc', 'UTF8'), 'base64'))
           WHEN 5 THEN jsonb_build_object('note', encode(convert_to('SEVEN77', 'UTF8'), 'base64'))
           WHEN 6 THEN jsonb_build_object('note', encode('\xffffffffffffff'::bytea || set_byte('\x00'::bytea, 0, (r + i) % 256), 'base64'))
           WHEN 7 THEN jsonb_build_object('note', encode('\xffffff'::bytea || sha256(convert_to(r || ':' || i, 'UTF8')), 'base64'))
           WHEN 8 THEN jsonb_build_object('note', encode(sha256(convert_to(r || ':' || i, 'UTF8')), 'base64'))
           ELSE '{}'::jsonb END)
FROM generate_series(1, 500) r, generate_series(0, 3) i;
-- Production-shaped index: 7-byte prefix, round-ordered, partial on notes.
CREATE INDEX pfx_txn_note7_idx
    ON pfx_txn (substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 7), round, intra, typeenum)
    WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 7) IS NOT NULL;
-- Partial-index expression stats are never used by the planner; these are.
CREATE STATISTICS pfx_txn_note7_stats
    ON (substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 7)) FROM pfx_txn;
ANALYZE pfx_txn;
-- Result equivalence: rewrite on (index forced) vs off (seq scan).
CREATE FUNCTION pfx_chk(q text, OUT same boolean, OUT n bigint) LANGUAGE plpgsql AS $$
DECLARE h_on text; h_off text; n_off bigint; w text;
BEGIN
  w := format('SELECT count(*), md5(coalesce(string_agg(x::text, E''\n'' ORDER BY x::text), '''')) FROM (%s) x', q);
  PERFORM set_config('pg_algorand.prefix_rewrite', 'on', true);
  PERFORM set_config('enable_seqscan', 'off', true);
  EXECUTE w INTO n, h_on;
  PERFORM set_config('pg_algorand.prefix_rewrite', 'off', true);
  PERFORM set_config('enable_seqscan', 'on', true);
  EXECUTE w INTO n_off, h_off;
  same := (h_on = h_off) AND (n = n_off);
END $$;
-- N = K: matched directly by the planner
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_txn
WHERE round >= 100 AND typeenum = 1
  AND substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 7) = '\x5350414d535041'::bytea
ORDER BY round, intra LIMIT 10;
                                                                                    QUERY PLAN                                                                                     
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_note7_idx on pfx_txn
         Index Cond: ((SUBSTRING(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text) FROM 1 FOR 7) = '\x5350414d535041'::bytea) AND (round >= 100) AND (typeenum = 1))
(3 rows)

-- N < K, len(B) = N: half-open range on the prefix, original clause dropped
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_txn
WHERE round >= 100 AND typeenum = 3
  AND substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\x616c67'::bytea
ORDER BY round, intra LIMIT 10;
                                                                                                                         QUERY PLAN                                                                                                                          
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_pkey on pfx_txn
         Index Cond: (round >= 100)
         Filter: ((typeenum = 3) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) >= '\x616c67'::bytea) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) < '\x616c68'::bytea))
(4 rows)

SELECT * FROM pfx_chk($$SELECT round, intra FROM pfx_txn WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\x616c67'::bytea$$);
 same |  n  
------+-----
 t    | 400
(1 row)

-- N < K, selective family: range becomes an Index Cond on the prefix index
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_txn
WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 6) = '\x616c676f3a66'::bytea
ORDER BY round, intra LIMIT 10;
                                                                                                                           QUERY PLAN                                                                                                                           
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Sort
         Sort Key: round, intra
         ->  Index Scan using pfx_txn_note7_idx on pfx_txn
               Index Cond: (("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) >= '\x616c676f3a66'::bytea) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) < '\x616c676f3a67'::bytea))
(5 rows)

SELECT * FROM pfx_chk($$SELECT round, intra FROM pfx_txn WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 6) = '\x616c676f3a66'::bytea$$);
 same | n 
------+---
 t    | 7
(1 row)

-- N < K, B all 0xFF: no upper bound
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_txn
WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\xffffff'::bytea
ORDER BY round, intra LIMIT 10;
                                                        QUERY PLAN                                                         
---------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_pkey on pfx_txn
         Filter: ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) >= '\xffffff'::bytea)
(3 rows)

SELECT * FROM pfx_chk($$SELECT round, intra FROM pfx_txn WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\xffffff'::bytea$$);
 same |  n  
------+-----
 t    | 400
(1 row)

