-- Nullable side of an outer join, and B coming from another relation
SELECT * FROM pfx_chk($$SELECT h.r, t.intra FROM generate_series(1, 500) h(r) LEFT JOIN pfx_txn t ON t.round = h.r WHERE substring(decode(t.txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\x616c67'::bytea$$);
 same |  n  
------+-----
 t    | 400
(1 row)

SELECT * FROM pfx_chk($$SELECT t.round, t.intra FROM pfx_txn t JOIN (VALUES ('\x616c676f3a'::bytea), ('\x616263'::bytea)) v(b) ON substring(decode(t.txn -> 'txn' ->> 'note', 'base64') from 1 for 5) = v.b$$);
 same |  n  
------+-----
 t    | 600
(1 row)

-- Parameters: custom plans see the value; generic plans derive only for N >= K
PREPARE p3(bigint, smallint, bytea) AS
SELECT round, intra FROM pfx_txn
WHERE round >= $1 AND typeenum = $2
  AND substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = $3
ORDER BY round, intra LIMIT 10;
PREPARE p12(bigint, smallint, bytea) AS
SELECT round, intra FROM pfx_txn
WHERE round >= $1 AND typeenum = $2
  AND substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 12) = $3
ORDER BY round, intra LIMIT 10;
SET plan_cache_mode = force_custom_plan;
EXPLAIN (COSTS OFF) EXECUTE p3(100, 3, '\x616c67');
                                                                                                                               QUERY PLAN                                                                                                                                
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_pkey on pfx_txn
         Index Cond: (round >= '100'::bigint)
         Filter: ((typeenum = '3'::smallint) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) >= '\x616c67'::bytea) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) < '\x616c68'::bytea))
(4 rows)

EXECUTE p3(100, 3, '\x616c67');
 round | intra 
-------+-------
   110 |     3
   111 |     2
   112 |     1
   113 |     0
   119 |     3
   120 |     2
   121 |     1
   122 |     0
   140 |     3
   141 |     2
(10 rows)

SET plan_cache_mode = force_generic_plan;
EXPLAIN (COSTS OFF) EXECUTE p12(100, 1, '\x5350414d5350414d2d303030');
                                                                                QUERY PLAN                                                                                
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_note7_idx on pfx_txn
         Index Cond: (("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) = "substring"($3, 1, 7)) AND (round >= $1) AND (typeenum = $2))
         Filter: (SUBSTRING(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text) FROM 1 FOR 12) = $3)
(4 rows)

EXECUTE p12(100, 1, '\x5350414d5350414d2d303030');
 round | intra 
-------+-------
   100 |     0
   100 |     1
   101 |     0
   107 |     3
   108 |     2
   108 |     3
   109 |     1
   109 |     2
   110 |     0
   110 |     1
(10 rows)

EXPLAIN (COSTS OFF) EXECUTE p3(100, 3, '\x616c67');
                                                              QUERY PLAN                                                              
--------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_pkey on pfx_txn
         Index Cond: (round >= $1)
         Filter: ((typeenum = $2) AND (SUBSTRING(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text) FROM 1 FOR 3) = $3))
(4 rows)

-- A generic plan for N < K cannot use the index and would look cheap to the
-- plan cache; the hook inflates its cost. N >= K generic plans are untouched.
CREATE FUNCTION pfx_cost(q text) RETURNS float8 LANGUAGE plpgsql AS $$
DECLARE j json;
BEGIN
    EXECUTE 'EXPLAIN (FORMAT JSON) ' || q INTO j;
    RETURN (j -> 0 -> 'Plan' ->> 'Total Cost')::float8;
END $$;
SELECT pfx_cost($$EXECUTE p3(100, 3, '\x616c67')$$) > 1e9 AS p3_generic_penalized,
       pfx_cost($$EXECUTE p12(100, 1, '\x5350414d5350414d2d303030')$$) < 1e9 AS p12_generic_cheap;
 p3_generic_penalized | p12_generic_cheap 
----------------------+-------------------
 t                    | t
(1 row)

RESET plan_cache_mode;
-- So in auto mode the statement stays on custom plans past the fifth use.
PREPARE p3c(bigint, smallint, bytea) AS
SELECT round, intra FROM pfx_txn
WHERE round >= $1 AND typeenum = $2
  AND substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = $3
ORDER BY round, intra LIMIT 10;
DO $$ BEGIN FOR i IN 1..5 LOOP EXECUTE $q$EXECUTE p3c(100, 3, '\x616c67')$q$; END LOOP; END $$;
EXPLAIN (COSTS OFF) EXECUTE p3c(100, 3, '\x616c67');
                                                                                                                               QUERY PLAN                                                                                                                                
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_pkey on pfx_txn
         Index Cond: (round >= '100'::bigint)
         Filter: ((typeenum = '3'::smallint) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) >= '\x616c67'::bytea) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) < '\x616c68'::bytea))
(4 rows)

EXPLAIN (COSTS OFF) EXECUTE p3c(100, 3, '\x616c67');
                                                                                                                               QUERY PLAN                                                                                                                                
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_pkey on pfx_txn
         Index Cond: (round >= '100'::bigint)
         Filter: ((typeenum = '3'::smallint) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) >= '\x616c67'::bytea) AND ("substring"(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text), 1, 7) < '\x616c68'::bytea))
(4 rows)

-- Runtime switch
SET pg_algorand.prefix_rewrite = off;
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_txn
WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\x616c67'::bytea
ORDER BY round, intra LIMIT 10;
                                                          QUERY PLAN                                                           
-------------------------------------------------------------------------------------------------------------------------------
 Limit
   ->  Index Scan using pfx_txn_pkey on pfx_txn
         Filter: (SUBSTRING(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text) FROM 1 FOR 3) = '\x616c67'::bytea)
(3 rows)

RESET pg_algorand.prefix_rewrite;
-- A table without a matching index is left alone
RESET enable_seqscan;
CREATE TABLE pfx_noidx AS SELECT * FROM pfx_txn WHERE round <= 50;
EXPLAIN (COSTS OFF)
SELECT round, intra FROM pfx_noidx
WHERE substring(decode(txn -> 'txn' ->> 'note', 'base64') from 1 for 3) = '\x616c67'::bytea;
                                                       QUERY PLAN                                                        
-------------------------------------------------------------------------------------------------------------------------
 Seq Scan on pfx_noidx
   Filter: (SUBSTRING(decode(((txn -> 'txn'::text) ->> 'note'::text), 'base64'::text) FROM 1 FOR 3) = '\x616c67'::bytea)
(2 rows)

DROP TABLE pfx_noidx;
DROP TABLE pfx_txn;
DROP FUNCTION pfx_chk(text);
